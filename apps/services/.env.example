# Origen permitido para CORS. Usa "*" para desarrollo o el dominio de tu app.
ALLOWED_ORIGIN=*

# Secreto de firma JWT. Debe tener al menos 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<genera-un-secreto-aleatorio-de-al-menos-32-caracteres>

# Duración de la sesión en segundos (por defecto 8 horas).
JWT_EXPIRES_IN=28800
